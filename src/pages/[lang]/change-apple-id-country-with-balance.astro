---
import IntentGuide from '../../components/IntentGuide.astro';
import { LOCALES, type Locale } from '../../i18n';
export function getStaticPaths() { return LOCALES.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const copy = {
  "en": {
    "title": "Change Apple Account country when a balance is left",
    "description": "Clear the balance with a suitable purchase or ask Apple about a small remainder, then check the other country-change requirements.",
    "sections": [
      {
        "h": "Check what blocks the change",
        "p": "Apple requires remaining account credit to be cleared before a country change. It also checks subscriptions, pending activity, and Family Sharing. A zero balance does not bypass those requirements."
      },
      {
        "h": "Choose a route for your actual balance",
        "p": "Check the catalog for the country currently on your account. The minimum is 15 RUB in Russia and $0.29 in the US as of October 2, 2026. An amount above that minimum may still have no exact combination. A listed-price match is conditional on current prices and any added tax."
      },
      {
        "h": "If you cannot make a suitable purchase",
        "p": "For a balance below the cost of one item, Apple directs people to Support. This is a free route without a Zero Balance purchase. If a proposed purchase exceeds the balance, it needs an accepted payment method for the difference; it is not usable without one."
      },
      {
        "h": "Follow Apple’s country-change instructions",
        "p": "Resolve subscriptions that block the change, wait for pending orders and refunds, review Family Sharing, and prepare any required payment details for the new country. Apple’s official guide below gives the current steps."
      }
    ]
  },
  "ru": {
    "title": "Как сменить страну Apple Account с остатком на балансе",
    "description": "Проверьте подходящую покупку или помощь Apple с маленьким остатком, затем остальные условия смены страны.",
    "sections": [
      {
        "h": "Проверьте причину ограничения",
        "p": "Перед сменой страны Apple требует убрать остаток баланса. Также могут мешать подписки, ожидающие операции и семейный доступ. Нулевой баланс не отменяет эти условия."
      },
      {
        "h": "Выберите путь для своей суммы",
        "p": "Проверьте каталог для текущей страны Apple Account. На 2 октября 2026 года минимум составляет 15 ₽ в России и $0.29 в США. Даже сумма выше минимума может не совпасть с комбинацией. Совпадение по каталогу зависит от текущих цен и дополнительного налога."
      },
      {
        "h": "Если подходящей покупки нет",
        "p": "Для остатка меньше цены одного товара Apple рекомендует обратиться в поддержку. Это бесплатно и не требует покупки Zero Balance. Если предложенная покупка превышает остаток, нужен поддерживаемый способ оплаты разницы. Без него такую покупку совершить не получится."
      },
      {
        "h": "Следуйте инструкции Apple",
        "p": "Разберитесь с мешающими подписками, дождитесь завершения заказов и возвратов, проверьте семейный доступ и подготовьте необходимые платёжные данные новой страны. Актуальные шаги приведены в официальной инструкции Apple ниже."
      }
    ]
  }
};
---
<IntentGuide {lang} slug="change-apple-id-country-with-balance" copy={copy[lang === 'ru' ? 'ru' : 'en']} />
