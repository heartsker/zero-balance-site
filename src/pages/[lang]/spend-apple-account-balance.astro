---
import IntentGuide from '../../components/IntentGuide.astro';
import { LOCALES, type Locale } from '../../i18n';
export function getStaticPaths() { return LOCALES.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const copy = {
  "en": {
    "title": "How to spend leftover Apple Account balance",
    "description": "Use your credit for an eligible purchase you want, or check whether a combination fits before buying.",
    "sections": [
      {
        "h": "Start with an eligible purchase",
        "p": "Apple Account credit can pay for eligible apps, in-app purchases, media, and services. Availability varies by country and purchase type. Buying an item for less than the balance reduces credit but leaves a remainder."
      },
      {
        "h": "Check Zero Balance prices first",
        "p": "Choose your Apple Account country and enter your balance. The checker shows whether the available purchases add up to your amount, or how much would remain."
      },
      {
        "h": "Read the checkout total",
        "p": "An exact catalog match is not a guarantee of the final charge. Apple may add tax, and rounding can occur per transaction. If the charge exceeds the available balance, another accepted payment method is needed. Check every Apple confirmation before paying."
      },
      {
        "h": "For a small unspendable remainder",
        "p": "If credit below the cost of one item prevents a country change, ask Apple Support. This does not require buying anything from Zero Balance. Do not add funds or buy part of a plan expecting a guaranteed reset."
      }
    ]
  },
  "ru": {
    "title": "Как потратить остаток Apple Account",
    "description": "Выберите нужную доступную покупку или проверьте, подходит ли комбинация товаров, прежде чем платить.",
    "sections": [
      {
        "h": "Начните с нужной покупки",
        "p": "Баланс Apple Account можно использовать для доступных приложений, встроенных покупок, контента и сервисов. Возможности зависят от страны и типа покупки. Товар дешевле баланса уменьшит сумму, но оставит остаток."
      },
      {
        "h": "Сначала проверьте цены Zero Balance",
        "p": "Выберите страну Apple Account и введите остаток. Калькулятор покажет, можно ли собрать вашу сумму из доступных покупок или сколько денег останется."
      },
      {
        "h": "Прочитайте итог при подтверждении",
        "p": "Совпадение по каталогу не гарантирует итоговое списание. Apple может добавить налог; округление может происходить на уровне операции. Если средств на балансе не хватает, нужен другой поддерживаемый способ оплаты. Проверяйте каждое подтверждение Apple до покупки."
      },
      {
        "h": "Если маленький остаток потратить не получается",
        "p": "Если сумма меньше цены одного товара мешает смене страны, обратитесь в поддержку Apple. Для этого не нужно покупать товары Zero Balance. Не пополняйте баланс и не покупайте часть плана в ожидании гарантированного обнуления."
      }
    ]
  }
};
---
<IntentGuide {lang} slug="spend-apple-account-balance" copy={copy[lang === 'ru' ? 'ru' : 'en']} />
