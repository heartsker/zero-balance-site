---
import IntentGuide from '../../components/IntentGuide.astro';
import { LOCALES, type Locale } from '../../i18n';
export function getStaticPaths() { return LOCALES.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const copy = {
  "en": {
    "title": "Ways to clear a small Apple Account balance",
    "description": "Compare purchases, a listed-price combination, and free Apple Support using the limits that matter for your account.",
    "sections": [
      {
        "h": "Use a purchase you already want",
        "p": "An eligible app, service, or media purchase may use your credit. It clears the balance only if the final charge uses all of it. A purchase below the balance leaves a remainder; a shortfall needs an accepted payment method."
      },
      {
        "h": "Check a Zero Balance combination",
        "p": "Enter your balance and Apple Account country to see whether Zero Balance purchases add up to your amount. Check the final price and any tax in the App Store before paying."
      },
      {
        "h": "Ask Apple Support for free help",
        "p": "Apple directs people with credit below the cost of one item to Support when changing country. There is no Zero Balance purchase requirement or universal published dollar threshold. Apple decides what can be done for the account."
      },
      {
        "h": "Keep the balance if you do not need to change country",
        "p": "You can leave credit for a future eligible purchase. Avoid a partial purchase solely to make the number smaller. Family Sharing does not transfer your balance to another person, and credit cannot be converted to Apple Pay funds."
      }
    ]
  },
  "ru": {
    "title": "Способы убрать небольшой остаток Apple Account",
    "description": "Сравните обычную покупку, комбинацию Zero Balance и бесплатную помощь Apple с учётом ограничений аккаунта.",
    "sections": [
      {
        "h": "Купите то, что уже нужно",
        "p": "Доступная покупка приложения, сервиса или контента может использовать баланс. Он станет нулевым только если итоговое списание израсходует всю сумму. Покупка дешевле оставит остаток, а для доплаты нужен поддерживаемый способ оплаты."
      },
      {
        "h": "Проверьте комбинацию Zero Balance",
        "p": "Введите остаток и выберите страну Apple Account. Калькулятор покажет, складываются ли покупки Zero Balance в вашу сумму. Перед оплатой проверьте итоговую цену и налог в App Store."
      },
      {
        "h": "Бесплатно обратитесь в поддержку Apple",
        "p": "При смене страны Apple направляет в поддержку пользователей с остатком меньше цены одного товара. Покупка Zero Balance не нужна; универсального порога в рублях или долларах Apple не публикует. Решение по аккаунту принимает Apple."
      },
      {
        "h": "Оставьте баланс для будущей покупки",
        "p": "Если менять страну не требуется, можно сохранить кредит до подходящей покупки. Не покупайте часть плана лишь для уменьшения числа. Семейный доступ не переносит баланс другому человеку; превратить его в средства Apple Pay нельзя."
      }
    ]
  }
};
---
<IntentGuide {lang} slug="alternatives" copy={copy[lang === 'ru' ? 'ru' : 'en']} />
