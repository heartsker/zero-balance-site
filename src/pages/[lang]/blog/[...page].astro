---
import type { GetStaticPaths, Page } from 'astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Section from '../../../components/Section.astro';
import Container from '../../../components/Container.astro';
import Reveal from '../../../components/Reveal.astro';
import { LOCALES, type Locale } from '../../../i18n';
import { DOMAIN } from '../../../lib/siteConfig';
import {
  postsForLocale,
  localizedTitle,
  localizedDescription,
  CATEGORY_LABELS,
  type BlogPostMeta,
} from '../../../lib/blogPosts';

// The blog ships in en + ru. Page 1 lives at /<lang>/blog/, deeper pages at
// /<lang>/blog/2/ etc. The `[...page]` rest route keeps page 1 prefix-free.
// NOTE: getStaticPaths runs before the frontmatter consts initialise, so its
// literals are inlined rather than referencing INDEX_LOCALES / PAGE_SIZE below.
export const getStaticPaths = (({ paginate }) =>
  (['en', 'ru'] as const)
    .filter((l) => LOCALES.includes(l))
    .flatMap((lang) => paginate(postsForLocale(lang), { params: { lang }, pageSize: 9 }))) satisfies GetStaticPaths;

const INDEX_LOCALES = ['en', 'ru'] as const;
const PAGE_SIZE = 9;

const lang = Astro.params.lang as Locale;
const { page } = Astro.props as { page: Page<BlogPostMeta> };

const COPY: Record<'en' | 'ru', { eyebrow: string; heading: string; description: string; pageWord: string; prev: string; next: string }> = {
  en: {
    eyebrow: 'Guides',
    heading: 'Zero Balance blog',
    description:
      'Practical guides on clearing your Apple Account balance, changing your Apple ID country, refunds, gift cards, and payment problems.',
    pageWord: 'Page',
    prev: 'Newer',
    next: 'Older',
  },
  ru: {
    eyebrow: 'Гайды',
    heading: 'Блог Zero Balance',
    description:
      'Практичные гайды о том, как обнулить баланс Apple Account, сменить страну Apple ID, вернуть деньги, использовать подарочные карты и решить проблемы с оплатой.',
    pageWord: 'Страница',
    prev: 'Новее',
    next: 'Старее',
  },
};
const c = COPY[lang === 'ru' ? 'ru' : 'en'];

const path = page.currentPage === 1 ? `/${lang}/blog/` : `/${lang}/blog/${page.currentPage}/`;
const title = page.currentPage === 1 ? c.heading : `${c.heading} - ${c.pageWord} ${page.currentPage}`;

// hreflang: a locale has this page only if it has enough posts to reach it.
const pageLocales = (INDEX_LOCALES as readonly Locale[]).filter(
  (l) => postsForLocale(l).length > (page.currentPage - 1) * PAGE_SIZE,
);

const categoryLabel = (category: BlogPostMeta['category']) =>
  CATEGORY_LABELS[category][lang] ?? CATEGORY_LABELS[category].en ?? '';
const dateLocale = lang === 'ru' ? 'ru-RU' : 'en-US';
const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: `${DOMAIN}${path}`,
  inLanguage: lang,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: page.data.map((post, i) => ({
      '@type': 'ListItem',
      position: page.start + i + 1,
      url: `${DOMAIN}/${lang}/blog/${post.slug}/`,
      name: localizedTitle(post, lang),
    })),
  },
};
---

<PageLayout {title} description={c.description} {lang} {path} locales={pageLocales} {schema}>
  <PageHeader eyebrow={c.eyebrow} title={c.heading} description={c.description} />

  <Section>
    <Container>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          page.data.map((post, i) => (
            <Reveal as="li" delay={(i % 3) * 60}>
              <a
                href={`/${lang}/blog/${post.slug}/`}
                class="flex h-full flex-col rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 transition-colors hover:border-[var(--brand)]"
              >
                <span class="inline-flex items-center gap-2 text-xs font-medium tracking-wide text-[var(--muted)] uppercase">
                  <span class="h-1.5 w-1.5 rounded-full bg-[var(--brand)]" />
                  {categoryLabel(post.category)}
                </span>
                <h2 class="mt-3 h3 text-pretty">{localizedTitle(post, lang)}</h2>
                <p class="mt-2 text-[var(--muted)] text-pretty">{localizedDescription(post, lang)}</p>
                <time datetime={post.date} class="mt-4 text-sm text-[var(--muted)]">
                  {formatDate(post.date)}
                </time>
              </a>
            </Reveal>
          ))
        }
      </ul>

      {
        page.lastPage > 1 && (
          <nav class="mt-12 flex items-center justify-center gap-4" aria-label={c.pageWord}>
            {page.url.prev ? (
              <a
                href={page.url.prev}
                rel="prev"
                class="rounded-full border border-[var(--border)] px-4 py-2 text-sm font-medium text-[var(--fg)] transition-colors hover:border-[var(--brand)]"
              >
                {c.prev}
              </a>
            ) : (
              <span class="rounded-full border border-[var(--border)] px-4 py-2 text-sm text-[var(--muted)] opacity-40">
                {c.prev}
              </span>
            )}
            <span class="text-sm text-[var(--muted)]">
              {c.pageWord} {page.currentPage} / {page.lastPage}
            </span>
            {page.url.next ? (
              <a
                href={page.url.next}
                rel="next"
                class="rounded-full border border-[var(--border)] px-4 py-2 text-sm font-medium text-[var(--fg)] transition-colors hover:border-[var(--brand)]"
              >
                {c.next}
              </a>
            ) : (
              <span class="rounded-full border border-[var(--border)] px-4 py-2 text-sm text-[var(--muted)] opacity-40">
                {c.next}
              </span>
            )}
          </nav>
        )
      }
    </Container>
  </Section>
</PageLayout>
