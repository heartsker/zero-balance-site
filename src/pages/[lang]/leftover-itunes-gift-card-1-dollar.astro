---
import IntentGuide from '../../components/IntentGuide.astro';
import { LOCALES, type Locale } from '../../i18n';
export function getStaticPaths() { return LOCALES.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const copy = {
  "en": {
    "title": "What can you do with $1.01 of Apple Account credit?",
    "description": "The current US catalog has a $1.00 item, but no exact $1.01 combination. Check the remainder, tax, and payment options before buying.",
    "sections": [
      {
        "h": "$1.01 does not match the current catalog",
        "p": "In the October 2, 2026 US catalog, Hearth Orb costs $1.00. Buying it from a $1.01 balance would leave $0.01 before any additional tax. No combination of current Zero Balance prices totals $1.01. A partial purchase should not be presented as a complete reset."
      },
      {
        "h": "For exactly $1.00, a listed-price match exists",
        "p": "Hearth Orb is one item at $1.00. This matches a $1.00 target by listed prices, but applicable tax can change the final charge. Check the Apple confirmation and use your actual Apple Account storefront."
      },
      {
        "h": "Without another usable payment method",
        "p": "A purchase above your balance needs an accepted payment method for the shortfall. If you do not have one, an overshoot is not an actionable route. Do not add more gift-card credit just to make the balance larger."
      },
      {
        "h": "Ask Apple about a small remainder",
        "p": "Apple directs people whose balance is below the price of one item to Support when changing country. Asking for this help is free and does not require buying from Zero Balance. Apple decides which option applies to your account."
      }
    ]
  },
  "ru": {
    "title": "Что делать с остатком $1.01 на Apple Account?",
    "description": "В текущем каталоге США есть товар за $1.00, но нет комбинации ровно на $1.01. Проверьте остаток, налог и способы оплаты до покупки.",
    "sections": [
      {
        "h": "$1.01 не совпадает с текущими ценами",
        "p": "По проверке 2 октября 2026 года Hearth Orb («Очагосфера») стоит $1.00 в магазине США. При балансе $1.01 после него останется $0.01 до возможного дополнительного налога. Комбинации ровно на $1.01 в каталоге нет. Частичный расход нельзя обещать как полное обнуление."
      },
      {
        "h": "Для ровно $1.00 совпадение по каталогу есть",
        "p": "Очагосфера стоит $1.00 за единицу. Это совпадает с остатком $1.00 по цене каталога, но налог может изменить итоговое списание. Проверьте подтверждение Apple и убедитесь, что выбрана текущая страна аккаунта."
      },
      {
        "h": "Если нет другого доступного способа оплаты",
        "p": "Покупка дороже остатка требует поддерживаемого способа оплаты разницы. Без него превышение суммы не является доступным решением. Не пополняйте аккаунт подарочными картами только ради увеличения баланса."
      },
      {
        "h": "Уточните помощь с маленьким остатком в Apple",
        "p": "Перед сменой страны Apple рекомендует обратиться в поддержку, если баланс меньше цены одного товара. Обращение бесплатно и не требует покупок Zero Balance. Решение для конкретного аккаунта принимает Apple."
      }
    ]
  }
};
---
<IntentGuide {lang} slug="leftover-itunes-gift-card-1-dollar" copy={copy[lang === 'ru' ? 'ru' : 'en']} />
