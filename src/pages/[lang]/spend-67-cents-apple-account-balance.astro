---
import IntentGuide from '../../components/IntentGuide.astro';
import { LOCALES, type Locale } from '../../i18n';
export function getStaticPaths() { return LOCALES.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const copy = {
  "en": {
    "title": "Can you spend exactly $0.67 of Apple Account balance?",
    "description": "The current US catalog cannot match $0.67. A $0.59 item leaves $0.08; $0.29 + $0.39 exceeds the balance by $0.01 before tax.",
    "sections": [
      {
        "h": "The current US prices",
        "p": "The October 2, 2026 audit lists 21 Zero Balance consumables, starting at $0.29, $0.39, $0.49, $0.59, and $0.69. No item or combination totals $0.67. The largest listed total below it is $0.59, leaving $0.08. Buying that item would reduce the balance, not clear it."
      },
      {
        "h": "Why a one-cent difference still matters",
        "p": "$0.29 + $0.39 = $0.68, one cent above the balance before any added tax. Apple would need an accepted payment method for a shortfall. If you do not have one, do not treat this as an available solution. US sales tax and transaction rounding can change the final charge."
      },
      {
        "h": "Ask Apple before making a partial purchase",
        "p": "If a small remainder blocks a country change, Apple Support is a free route. Apple’s published guidance refers to a balance below the cost of a single item; it does not publish a universal $0.69 or $1 cutoff or guarantee every request. Ask Apple which option applies to your account."
      },
      {
        "h": "Check your own storefront",
        "p": "A USD currency label alone does not identify the storefront. Select the Apple Account country in the price checker and enter the balance yourself. The site cannot read your account balance or confirm that Apple will accept a payment."
      }
    ]
  },
  "ru": {
    "title": "Можно ли потратить ровно $0.67 с баланса Apple Account?",
    "description": "В текущем каталоге США комбинации на $0.67 нет. Товар за $0.59 оставит $0.08, а $0.29 + $0.39 потребуют доплаты $0.01 до налога.",
    "sections": [
      {
        "h": "Что показывают текущие цены США",
        "p": "По проверке 2 октября 2026 года в Zero Balance 21 расходуемый товар. Первые цены: $0.29, $0.39, $0.49, $0.59 и $0.69. Ровно $0.67 из них не собрать. Ближайшая сумма снизу — $0.59, после неё останется $0.08. Такая покупка уменьшит остаток, но не обнулит его."
      },
      {
        "h": "Почему доплата в один цент не всегда возможна",
        "p": "$0.29 + $0.39 = $0.68: это на один цент больше баланса до возможного налога. Для доплаты Apple нужен поддерживаемый способ оплаты. Если его нет, эта комбинация не решает задачу. Налог в США и округление каждой операции могут изменить списание."
      },
      {
        "h": "Обратитесь в Apple до частичной покупки",
        "p": "Если маленький остаток мешает сменить страну, можно бесплатно обратиться в поддержку Apple. Официальная инструкция говорит об остатке меньше цены одного товара, а не об универсальном пороге $0.69 или $1. Решение по конкретному аккаунту принимает Apple."
      },
      {
        "h": "Выберите страну аккаунта",
        "p": "Валюта USD сама по себе не определяет магазин. Выберите страну Apple Account в каталоге и введите остаток. Сайт не читает баланс и не проверяет возможность оплаты."
      }
    ]
  }
};
---
<IntentGuide {lang} slug="spend-67-cents-apple-account-balance" copy={copy[lang === 'ru' ? 'ru' : 'en']} />
