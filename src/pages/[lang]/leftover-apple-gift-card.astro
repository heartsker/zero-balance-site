---
import IntentGuide from '../../components/IntentGuide.astro';
import { LOCALES, type Locale } from '../../i18n';
export function getStaticPaths() { return LOCALES.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const copy = {
  "en": {
    "title": "What to do with leftover Apple Gift Card credit",
    "description": "Once redeemed, gift-card credit follows the Apple Account balance rules for that storefront.",
    "sections": [
      {
        "h": "Confirm which balance you have",
        "p": "Unredeemed gift-card value and credit already added to your Apple Account are different. The Zero Balance checker is for the amount already on your Apple Account. Read that amount in the App Store and select the matching storefront."
      },
      {
        "h": "Check whether purchases fit",
        "p": "The current catalog starts at 15 RUB in Russia and $0.29 in the US. Every Russian price is a whole number of rubles; combining them cannot spend kopecks exactly. Some US cent amounts also have no exact combination, including $0.21 and $0.67."
      },
      {
        "h": "Avoid creating another remainder",
        "p": "A purchase below your credit leaves money on the account. One above it requires another accepted payment method for the shortfall and any added tax. Do not add more gift cards without a concrete purchase plan and verified checkout terms."
      },
      {
        "h": "Ask Apple about a small balance",
        "p": "If the remaining credit is below the price of one item and prevents a country change, contact Apple Support for free. Cash refunds are generally unavailable except where required by law; Apple can explain whether an exception applies."
      }
    ]
  },
  "ru": {
    "title": "Что делать с остатком подарочной карты Apple",
    "description": "После активации кредит подарочной карты подчиняется правилам баланса Apple Account для выбранного магазина.",
    "sections": [
      {
        "h": "Уточните, где лежат деньги",
        "p": "Номинал ещё не активированной карты и деньги, уже зачисленные на Apple Account, — разные вещи. Проверщик Zero Balance рассчитан на сумму в аккаунте. Посмотрите её в App Store и выберите соответствующую страну магазина."
      },
      {
        "h": "Проверьте, подходят ли покупки",
        "p": "Текущий каталог начинается с 15 ₽ в России и $0.29 в США. Все российские цены кратны рублю: комбинация не позволит потратить копейки точно. Некоторые суммы в американском магазине тоже недостижимы, например $0.21 и $0.67."
      },
      {
        "h": "Не создавайте новый остаток",
        "p": "Покупка дешевле баланса оставит деньги на аккаунте. Для покупки дороже нужен другой доступный способ оплаты разницы и возможного налога. Не активируйте новые карты без конкретного плана и проверки условий оплаты."
      },
      {
        "h": "Спросите Apple о маленьком остатке",
        "p": "Если остаток меньше цены одного товара мешает сменить страну, можно бесплатно обратиться в поддержку Apple. Возврат денег обычно недоступен, кроме случаев, предусмотренных законом; применимость исключения уточняет Apple."
      }
    ]
  }
};
---
<IntentGuide {lang} slug="leftover-apple-gift-card" copy={copy[lang === 'ru' ? 'ru' : 'en']} />
