---
import IntentGuide from '../../components/IntentGuide.astro';
import { LOCALES, type Locale } from '../../i18n';
export function getStaticPaths() { return LOCALES.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const copy = {
  "en": {
    "title": "How to clear Apple Account balance before changing country",
    "description": "Compare an exact purchase combination, payment of a shortfall, and free help from Apple. There is no guaranteed reset for every amount.",
    "sections": [
      {
        "h": "Check a listed-price combination",
        "p": "Choose your Apple Account country and enter your balance to find matching purchases. Tax can change the total, so check the final charge in the App Store."
      },
      {
        "h": "Understand payment of a shortfall",
        "p": "Apple attempts to use account credit first, then other payment methods when needed. This requires an accepted method and an account that can make purchases. A small shortfall is still a payment obligation, not a free way to clear credit."
      },
      {
        "h": "Ask Apple about an unspendable small balance",
        "p": "If credit below the price of one item blocks a country change, use Apple Support. No purchase through Zero Balance is required. There is no published universal dollar cutoff, and the website cannot promise Apple’s decision."
      },
      {
        "h": "Check other country-change requirements",
        "p": "A zero balance alone does not guarantee a region change. Follow Apple’s instructions for subscriptions, pending transactions, Family Sharing, and payment details for the new country."
      }
    ]
  },
  "ru": {
    "title": "Как обнулить Apple Account перед сменой страны",
    "description": "Сравните точную комбинацию покупок, оплату недостающей суммы и бесплатную помощь Apple. Гарантированного сброса для любого остатка нет.",
    "sections": [
      {
        "h": "Проверьте комбинацию по ценам магазина",
        "p": "Выберите страну Apple Account и введите остаток, чтобы подобрать покупки на эту сумму. Налог может изменить итог — проверьте сумму списания в App Store."
      },
      {
        "h": "Уточните возможность доплаты",
        "p": "Apple сначала пытается использовать баланс, затем другие способы оплаты при необходимости. Нужен поддерживаемый способ и возможность совершать покупки с аккаунта. Даже маленькая доплата требует оплаты, а не даёт бесплатного обнуления."
      },
      {
        "h": "Спросите Apple о маленьком непотраченном остатке",
        "p": "Если сумма меньше цены одного товара мешает смене страны, обратитесь в поддержку Apple. Покупать что-либо в Zero Balance не нужно. Универсального порога в рублях или долларах Apple не публикует; сайт не может обещать решение поддержки."
      },
      {
        "h": "Проверьте остальные условия смены страны",
        "p": "Нулевой баланс не гарантирует смену региона. Следуйте инструкции Apple по подпискам, ожидающим операциям, семейному доступу и платёжным данным новой страны."
      }
    ]
  }
};
---
<IntentGuide {lang} slug="reset-apple-id-balance" copy={copy[lang === 'ru' ? 'ru' : 'en']} />
