---
import IntentGuide from '../../components/IntentGuide.astro';
import { LOCALES, type Locale } from '../../i18n';
export function getStaticPaths() { return LOCALES.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const copy = {
  "en": {
    "title": "How to remove a small Apple Account balance",
    "description": "Check whether purchases fit your balance, or use Apple Support when a small remainder blocks a country change.",
    "sections": [
      {
        "h": "Start with the amount and storefront",
        "p": "Read the actual balance in the App Store and check the Apple Account country or region. The language of your phone does not set purchase prices. Our dated catalog has all 21 current consumables across 175 storefronts."
      },
      {
        "h": "For 3 RUB or $0.21, check support first",
        "p": "The lowest current Zero Balance price is 15 RUB in Russia and $0.29 in the US. A 3 RUB balance or a $0.21 US balance is below that minimum. No combination of these purchases spends it exactly. A larger purchase needs an accepted payment method for the shortfall and any added tax."
      },
      {
        "h": "For larger amounts, check a combination",
        "p": "The checker shows whether purchases add up to your balance and how much would remain. Check the final price and tax in the App Store before paying."
      },
      {
        "h": "Clearing credit is different from a cash refund",
        "p": "Apple Support may help with a small balance before a country change. Clearing credit is not the same as returning it to a bank card. Apple notes exceptions for cash refunds required by law; ask Apple if those apply to your case."
      }
    ]
  },
  "ru": {
    "title": "Как убрать небольшой остаток Apple Account",
    "description": "Проверьте, подходит ли комбинация покупок, или обратитесь в Apple, если маленький остаток мешает сменить страну.",
    "sections": [
      {
        "h": "Начните с суммы и страны магазина",
        "p": "Посмотрите фактический баланс в App Store и страну Apple Account. Язык телефона не определяет цены. В каталоге на 2 октября 2026 года есть все 21 расходуемый товар для 175 магазинов."
      },
      {
        "h": "Для 3 ₽ или $0.21 сначала проверьте помощь Apple",
        "p": "Минимальная цена Zero Balance составляет 15 ₽ в России и $0.29 в США. Остаток 3 ₽ или $0.21 в американском магазине меньше минимума: точно потратить его этими покупками нельзя. Покупка дороже остатка требует подходящего способа оплаты для доплаты и возможного налога."
      },
      {
        "h": "Для большей суммы проверьте комбинацию",
        "p": "Калькулятор покажет, складываются ли покупки в вашу сумму и сколько денег останется. Перед оплатой проверьте итоговую цену и налог в App Store."
      },
      {
        "h": "Списание остатка и возврат денег различаются",
        "p": "Поддержка Apple может помочь с маленьким остатком перед сменой страны. Его списание не означает возврат на банковскую карту. Apple указывает исключения для денежных возвратов по закону; применимость к вашему случаю уточняет Apple."
      }
    ]
  }
};
---
<IntentGuide {lang} slug="remove-leftover-apple-id-balance" copy={copy[lang === 'ru' ? 'ru' : 'en']} />
