---
import IntentGuide from '../../components/IntentGuide.astro';
import { LOCALES, type Locale } from '../../i18n';
export function getStaticPaths() { return LOCALES.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
const copy = {
  "en": {
    "title": "Apple Account balance will not reach zero",
    "description": "Check the minimum price, gaps between available totals, taxes, and payment restrictions before buying again.",
    "sections": [
      {
        "h": "A balance can miss every available combination",
        "p": "Being above the cheapest item does not guarantee a match. For example, $0.67 cannot be assembled from the current US prices. In Russia the minimum is 15 RUB and every price is a whole number of rubles, so a remainder with kopecks cannot be matched exactly."
      },
      {
        "h": "Why repeating a purchase may not help",
        "p": "Purchasing below the balance can leave an even smaller remainder. An additional purchase above it needs another accepted payment method. Tax added at checkout may also break an apparent match. Recheck the actual balance and do not keep buying based only on a predicted zero."
      },
      {
        "h": "Use the free support route when purchases do not fit",
        "p": "For a balance below the cost of one item that prevents a country change, Apple recommends contacting Support. Explain the current amount and storefront. You do not need to install or buy anything in Zero Balance to ask for help."
      },
      {
        "h": "If the balance is zero but the region is still blocked",
        "p": "Review subscriptions that block a country change, pending refunds and orders, rentals, and Family Sharing. These restrictions are separate from the balance. Follow Apple’s current country-change instructions."
      }
    ]
  },
  "ru": {
    "title": "Баланс Apple Account не уходит в ноль",
    "description": "Проверьте минимальную цену, доступные комбинации, налог и ограничения оплаты до следующей покупки.",
    "sections": [
      {
        "h": "Даже сумма выше минимума может не совпасть",
        "p": "Остаток выше самого дешёвого товара не обязательно получится потратить точно. Например, в каталоге США нет комбинации на $0.67. В России минимум составляет 15 ₽, все цены кратны рублю, поэтому остаток с копейками не совпадёт с суммой покупок."
      },
      {
        "h": "Почему повторная покупка может не помочь",
        "p": "Частичный расход оставляет ещё меньшую сумму. Чтобы купить товар дороже остатка, нужен другой поддерживаемый способ оплаты. Дополнительный налог тоже может нарушить совпадение. Проверьте реальный баланс и не продолжайте покупки только из-за расчётного нуля."
      },
      {
        "h": "Бесплатная помощь, если покупки не подходят",
        "p": "Если остаток меньше цены одного товара мешает смене страны, Apple рекомендует обратиться в поддержку. Укажите сумму и страну аккаунта. Для обращения не нужно устанавливать Zero Balance или что-либо покупать в нём."
      },
      {
        "h": "Если ноль уже достигнут, а страну сменить нельзя",
        "p": "Проверьте мешающие смене страны подписки, ожидающие возвраты и заказы, аренду контента и семейный доступ. Эти ограничения не связаны с подбором покупок. Следуйте актуальной инструкции Apple."
      }
    ]
  }
};
---
<IntentGuide {lang} slug="apple-id-balance-wont-go-to-zero" copy={copy[lang === 'ru' ? 'ru' : 'en']} />
