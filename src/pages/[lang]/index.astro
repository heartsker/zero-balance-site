---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Eligibility from '../../components/Eligibility.astro';
import TrustBand from '../../components/TrustBand.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import FAQ from '../../components/FAQ.astro';
import FinalCta from '../../components/FinalCta.astro';
import Reveal from '../../components/Reveal.astro';
import Reviews from '../../components/Reviews.astro';
import { getDict, localizedPath, LOCALES, type Locale } from '../../i18n';
import { DOMAIN } from '../../lib/siteConfig';
import { softwareApplicationSchema, faqSchema, aggregateRatingSchema } from '../../lib/schema';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = getDict(lang);
const path = `/${lang}/`;

const title = t.meta.defaultTitle;
const description = t.meta.defaultDescription;

const teaserItems = t.faq.items.slice(0, 5);

// JSON-LD `screenshot` URLs point at the build-optimized WebP variants so the
// structured data matches what the page serves (the raw public PNGs moved into
// src/assets). Absolute URLs are required, hence the DOMAIN prefix.
const screenshotImports = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/screenshots/*/*.png',
  { eager: true },
);
const screenshotUrls = await Promise.all(
  [1, 2, 3].map(async (n) => {
    const optimized = await getImage({
      src: screenshotImports[`../../assets/screenshots/${lang}/${n}.png`].default,
      width: 1080,
      format: 'webp',
    });
    return new URL(optimized.src, DOMAIN).href;
  }),
);

const schemas = [
  softwareApplicationSchema({ description, lang, screenshots: screenshotUrls }),
  faqSchema(teaserItems),
  aggregateRatingSchema(),
];
---

<PageLayout
  {title}
  {description}
  {lang}
  {path}
  schema={schemas}
  keywords={[...t.keywords.home, ...t.keywords.site]}
>
  <Hero {lang} />
  <TrustBand {lang} />
  <Eligibility {lang} />
  <HowItWorks {lang} />
  <Reviews {lang} />

  <Section id="faq" variant="surface">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <Reveal>
          <h2 class="h2 text-balance">{t.faqTeaser.title}</h2>
        </Reveal>
        <Reveal delay={80}>
          <p class="lead mt-4 text-pretty">{t.faqTeaser.subtitle}</p>
        </Reveal>
      </div>
      <Reveal class="mx-auto mt-10 max-w-3xl md:mt-14">
        <FAQ
          items={teaserItems}
          detailHrefBase={localizedPath(lang, 'faq')}
          detailLabel={t.faq.readFullAnswer}
        />
        <div class="mt-6 text-center">
          <a
            href={localizedPath(lang, 'faq')}
            class="text-sm font-medium text-[var(--brand)] underline-offset-4 hover:underline"
          >
            {t.cta.seeAllFaq} &rarr;
          </a>
        </div>
      </Reveal>
    </Container>
  </Section>

  <FinalCta {lang} />
</PageLayout>
