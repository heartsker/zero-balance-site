---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import { DEFAULT_LOCALE } from '../lib/siteConfig';

// Link the default-locale home so this single shared 404 works on both builds.
// Global: /en/ (exists). RU mirror: /ru/, which the deploy's leading-/ru/ rewrite
// flattens to the real root home (/en/ is pruned there, so it must not be hardcoded).
const homeHref = `/${DEFAULT_LOCALE}/`;
---

<BaseLayout
  title="Not found - Zero Balance"
  description="The page you are looking for does not exist."
  lang="en"
  path="/404/"
  noindex={true}
>
  <main id="main">
    <Container class="flex min-h-[70vh] flex-col items-center justify-center py-20 text-center">
      <p class="text-6xl font-bold tracking-tight">404</p>
      <h1 class="mt-4 h2">Page not found</h1>
      <p class="mt-3 lead max-w-md">
        The page you are looking for does not exist or has moved. Use one of these verified paths to continue.
      </p>
      <nav aria-label="Recovery links" class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={homeHref} class="cta">Go to homepage</a>
        <a href={`/${DEFAULT_LOCALE}/help/`} class="cta cta--ghost">Open help</a>
        <a href="/sitemap-index.xml" class="cta cta--ghost">View sitemap</a>
        <a href="/llms.txt" class="cta cta--ghost">Read agent instructions</a>
        <a href="/404.md" class="cta cta--ghost">Open Markdown recovery guide</a>
      </nav>
    </Container>
  </main>
</BaseLayout>
