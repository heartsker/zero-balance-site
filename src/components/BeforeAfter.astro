---
import { getDict, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDict(lang);
const ba = t.beforeAfter;
---

<div class="mx-auto mt-10 max-w-xl md:mt-14">
  <div class="flex flex-col items-stretch gap-2.5 rounded-[1.4rem] bg-[#0F0C1B] p-2.5 shadow-[0_18px_40px_-20px_rgba(122,77,230,0.55)] sm:flex-row sm:items-stretch sm:gap-2">
    <!-- Before: balance present, region locked -->
    <div class="flex-1 rounded-[1.1rem] bg-[#1B1730] px-4 py-3.5">
      <span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#9890B4]">{ba.beforeLabel}</span>
      <div class="mt-2 flex items-baseline justify-between gap-2">
        <span class="text-[11px] text-[#9890B4]">{ba.balanceLabel}</span>
        <span class="text-lg font-bold tabular-nums text-white">{ba.beforeAmount}</span>
      </div>
      <div class="mt-2.5 flex items-center gap-1.5 text-[11px] leading-tight text-[#9890B4]">
        <svg class="shrink-0" width="13" height="13" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <rect x="4.5" y="8.75" width="11" height="7.25" rx="1.8" stroke="currentColor" stroke-width="1.4" />
          <path d="M7 8.75V6.75a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
        <span>{ba.beforeStatus}</span>
      </div>
    </div>

    <!-- Arrow -->
    <div class="flex shrink-0 items-center justify-center" aria-hidden="true">
      <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#7A4DE6] text-white shadow-[0_4px_14px_rgba(122,77,230,0.6)]">
        <svg class="rotate-90 sm:rotate-0 rtl:sm:-scale-x-100" width="15" height="15" viewBox="0 0 24 24" fill="none">
          <path d="M5 12h13M12 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>

    <!-- After: balance cleared, region unlocked -->
    <div class="flex-1 rounded-[1.1rem] bg-[#251B43] px-4 py-3.5 ring-1 ring-[#7A4DE6]/55">
      <span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#BBA6F7]">{ba.afterLabel}</span>
      <div class="mt-2 flex items-baseline justify-between gap-2">
        <span class="text-[11px] text-[#9890B4]">{ba.balanceLabel}</span>
        <span class="text-lg font-bold tabular-nums text-white">{ba.afterAmount}</span>
      </div>
      <div class="mt-2.5 flex items-center gap-1.5 text-[11px] font-medium leading-tight text-[#BBA6F7]">
        <svg class="shrink-0" width="13" height="13" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>{ba.afterStatus}</span>
      </div>
    </div>
  </div>
</div>
