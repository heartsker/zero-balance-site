---
import { getDict, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDict(lang);
const ba = t.beforeAfter;
---

<div class="mx-auto w-full max-w-sm">
  <!-- Before: balance present, region locked -->
  <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 shadow-sm">
    <span class="text-xs font-semibold uppercase tracking-wide text-[var(--muted)]">{ba.beforeLabel}</span>
    <div class="mt-3 flex items-baseline justify-between gap-3">
      <span class="text-sm text-[var(--muted)]">{ba.balanceLabel}</span>
      <span class="text-2xl font-semibold text-[var(--fg)]">{ba.beforeAmount}</span>
    </div>
    <div class="mt-3 flex items-center gap-2 text-sm text-[var(--muted)]">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <rect x="4.5" y="8.5" width="11" height="8" rx="2" stroke="currentColor" stroke-width="1.5" />
        <path d="M7 8.5V6.5a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <span>{ba.beforeStatus}</span>
    </div>
  </div>

  <!-- Arrow -->
  <div class="flex justify-center py-1.5" aria-hidden="true">
    <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[var(--brand)] text-white shadow-[var(--shadow-2)]">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M12 5v14M6 13l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>

  <!-- After: balance cleared, region unlocked -->
  <div class="rounded-2xl border border-[color-mix(in_srgb,var(--brand)_35%,var(--border))] bg-[var(--brand-soft)] p-5 shadow-sm">
    <span class="text-xs font-semibold uppercase tracking-wide text-[var(--brand-strong)]">{ba.afterLabel}</span>
    <div class="mt-3 flex items-baseline justify-between gap-3">
      <span class="text-sm text-[var(--muted)]">{ba.balanceLabel}</span>
      <span class="text-2xl font-semibold text-[var(--brand-strong)]">{ba.afterAmount}</span>
    </div>
    <div class="mt-3 flex items-center gap-2 text-sm font-medium text-[var(--brand-strong)]">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>{ba.afterStatus}</span>
    </div>
  </div>
</div>
