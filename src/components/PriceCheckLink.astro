---
import type { Locale } from '../i18n';
import { localizedPath } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
---
{(lang === 'ru' || lang === 'en') && <aside class="mx-auto max-w-3xl px-5 py-6 leading-relaxed">
  <h2 class="h3">{lang === 'ru' ? 'Сначала проверьте сумму' : 'Check your amount first'}</h2>
  <p class="mt-3">{lang === 'ru' ? 'Минимум по проверке 2 октября 2026: 15 ₽ в России, $0.29 в США. Не каждый остаток совпадёт с покупками. Налог может изменить итог, а для доплаты нужен доступный способ оплаты.' : 'Minimum prices checked October 2, 2026: 15 RUB in Russia, $0.29 in the US. Not every balance matches. Tax can change the total, and a shortfall needs an accepted payment method.'}</p>
  <div class="mt-4 flex flex-wrap gap-5 font-semibold underline">
    <a href={localizedPath(lang, 'prices')}>{lang === 'ru' ? 'Цены и проверка комбинации' : 'Prices and combination checker'}</a>
    <a href="https://support.apple.com/118283">{lang === 'ru' ? 'Бесплатная помощь Apple при маленьком остатке' : 'Free Apple help for a small balance'}</a>
  </div>
</aside>}
