{
  "name": "zero-balance-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing site for the ZeroBalance iOS app (zerobalance.pro).",
  "homepage": "https://zerobalance.pro/",
  "repository": {
    "type": "git",
    "url": "https://github.com/heartsker/zero-balance-site.git"
  },
  "bugs": {
    "url": "https://zerobalance.pro/en/contact/"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/build.mjs",
    "build:yandex": "node scripts/build-yandex.mjs dist-ru",
    "test": "npm run build && node scripts/build-yandex.mjs dist-test-ru && vitest run",
    "verify:agents": "node scripts/verify-agent-readiness.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:cloudflare": "node scripts/deploy.mjs cloudflare",
    "deploy:yandex": "node scripts/deploy.mjs yandex",
    "deploy:yandex:agent": "node scripts/deploy-yandex-agent.mjs --cutover",
    "preflight:yandex:agent": "node scripts/deploy-yandex-agent.mjs",
    "deploy:all": "node scripts/deploy.mjs all",
    "astro": "astro",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:all": "node scripts/indexnow.mjs --all",
    "indexnow:dry": "node scripts/indexnow.mjs --dry-run",
    "indexnow:ru": "node scripts/indexnow.mjs --host=zerobalanceapp.ru --dist=dist-ru",
    "purge:yandex": "node scripts/purge-cdn.mjs",
    "purge:yandex:dry": "node scripts/purge-cdn.mjs --dry-run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.0.3",
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.6",
    "astro": "^5.1.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "cheerio": "^1.2.0",
    "turndown": "^7.2.4",
    "vitest": "^4.1.11"
  }
}
